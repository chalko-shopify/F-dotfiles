.pi/skills/
.agents/skills/*
!.agents/skills/beads/
!.agents/skills/beads/**

/bin/
__pycache__/
*.py[cod]
*$py.class

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
